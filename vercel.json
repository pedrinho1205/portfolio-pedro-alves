{
    "version": 2,
    "builds": [
        { "src": "api/index.php", "use": "vercel-php@0.6.1" },
        { "src": "public/**", "use": "@vercel/static" }
    ],
    "routes": [
        { "src": "/build/(.*)", "dest": "/public/build/$1" },
        { "src": "/img/(.*)", "dest": "/public/img/$1" },
        { "src": "/curriculo.pdf", "dest": "/public/curriculo.pdf" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ]
}
