# Copie estas variáveis para Vercel > Project Settings > Environment Variables.
# Gere a chave com: php artisan key:generate --show
APP_NAME="Pedro Alves"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:q1iO+BkwIPbOID3qvB3PrA55qJwSCL7l7P5y/qHRgOA=
APP_URL=https://portfolio-pedro-alves.vercel.app

# Filesystem somente leitura: caches e views compiladas em /tmp
APP_CONFIG_CACHE=/tmp/config.php
APP_EVENTS_CACHE=/tmp/events.php
APP_PACKAGES_CACHE=/tmp/packages.php
APP_ROUTES_CACHE=/tmp/routes.php
APP_SERVICES_CACHE=/tmp/services.php
VIEW_COMPILED_PATH=/tmp/storage/framework/views

SESSION_DRIVER=cookie
CACHE_STORE=array
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=error
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
